data={https://github.com/DSAIL-SKKU/Detecting-BD-from-Misdiagnosed-MDD_NAACL_2024},
pdf={https://aclanthology.org/2024.naacl-long.278.pdf},
video={https://www.youtube.com/watch?v=uirizlPeWn4&list=PLo9gvoc_vNTsNluPuW3frixQSOwAlrRFB&index=11&ab_channel=DSAILSKKU}
